# Shared env keys for lkwd-nuxt-tmpl.
# Copy to .env.local / .env.test / .env.e2e and adjust.
SYS_ENV=local
NODE_ENV=development
NUXT_TELEMETRY_DISABLED=1
NITRO_PRESET=node-server
HOST=127.0.0.1
PORT=3000
NUXT_PUBLIC_APP_ENV=development
NUXT_PUBLIC_DEPLOYMENT_TARGET=local
NUXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
